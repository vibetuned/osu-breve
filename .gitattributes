# Line endings follow osu!'s: stored as LF, checked out as CRLF for the files .editorconfig wants in CRLF.
* text=auto
*.cs text diff=csharp eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.sln text eol=crlf
*.manifest text eol=crlf
*.md text eol=lf
*.sh text eol=lf
*.yml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
