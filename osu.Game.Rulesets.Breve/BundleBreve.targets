<Project>
  <!-- Bundles osu!breve into an osu! app built from source. osu!'s mobile apps can't load rulesets from files, so a ruleset has to be part of the app.

       An osu! checkout's local, gitignored osu.iOS.csproj.user or osu.Android.csproj.user imports this file:

         <Import Project="path/to/osu-breve/osu.Game.Rulesets.Breve/BundleBreve.targets" />

       osu!breve then has to build against that same checkout rather than osu!'s published packages, or the app would have two different copies of osu!.
       An untracked osu.local.props at the root of osu-breve sets that up, with the checkout's path, absolute or relative to osu-breve:

         <Project>
           <PropertyGroup>
             <OsuRepository>path/to/osu</OsuRepository>
           </PropertyGroup>
         </Project>

       On iOS, osu! then finds osu!breve in the app bundle like its own rulesets. Android only finds rulesets whose assemblies are already loaded,
       which OsuGameActivity does by name for osu!'s own, so there a module initializer loads osu!breve's assembly as soon as the app starts. -->

  <!-- Another ruleset bundled into the same app sets OsuRepository too, so it's cleared before reading this repository's. -->
  <PropertyGroup>
    <OsuRepository />
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\osu.local.props" Condition="Exists('$(MSBuildThisFileDirectory)..\osu.local.props')" />

  <PropertyGroup>
    <_BreveOsuRepository Condition="'$(OsuRepository)' != ''">$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory), '..', $(OsuRepository)))</_BreveOsuRepository>
    <_AppOsuRepository>$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), '..'))</_AppOsuRepository>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)osu.Game.Rulesets.Breve.csproj" />
  </ItemGroup>

  <Target Name="_CheckBreveBuildsAgainstThisOsu" BeforeTargets="ResolveProjectReferences">
    <Error Condition="'$(_BreveOsuRepository)' != '$(_AppOsuRepository)'"
           Text="osu!breve has to build against this osu! checkout ($(_AppOsuRepository)) to be bundled into its app. Set OsuRepository to it in $([MSBuild]::NormalizePath($(MSBuildThisFileDirectory), '..', 'osu.local.props'))." />
  </Target>

  <Target Name="_GenerateBreveLoader" BeforeTargets="CoreCompile" Condition="'$(TargetPlatformIdentifier)' == 'android'">
    <PropertyGroup>
      <_BreveLoaderPath>$(IntermediateOutputPath)BreveRulesetLoader.g.cs</_BreveLoaderPath>
    </PropertyGroup>
    <ItemGroup>
      <_BreveLoaderLine Include="// Generated by BundleBreve.targets, to load osu!breve as soon as the app starts so that RulesetStore finds it." />
      <_BreveLoaderLine Include="internal static class BreveRulesetLoader" />
      <_BreveLoaderLine Include="{" />
      <_BreveLoaderLine Include="#pragma warning disable CA2255" />
      <_BreveLoaderLine Include="[System.Runtime.CompilerServices.ModuleInitializer]" />
      <_BreveLoaderLine Include="internal static void Load() =&gt; System.Reflection.Assembly.Load(&quot;osu.Game.Rulesets.Breve&quot;)%3B" />
      <_BreveLoaderLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_BreveLoaderPath)" Lines="@(_BreveLoaderLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_BreveLoaderPath)" />
      <FileWrites Include="$(_BreveLoaderPath)" />
    </ItemGroup>
  </Target>
</Project>
