<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Description>follow the scan line. to the measure.</Description>
  </PropertyGroup>

  <ItemGroup Label="Package References" Condition="'$(OsuRepository)' == ''">
    <PackageReference Include="ppy.osu.Game" Version="$(OsuVersion)" />
  </ItemGroup>

  <!-- osu! from source, set by osu.local.props. -->
  <ItemGroup Label="Project References" Condition="'$(OsuRepository)' != ''">
    <ProjectReference Include="$(OsuRepository)osu.Game\osu.Game.csproj" />
  </ItemGroup>
</Project>
